{
  "name": "pomodoro",
  "version": "0.3.6",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "tauri": "tauri",
    "build:tauri": "tauri build",
    "tauri:build": "tauri build",
    "dev:tauri": "tauri dev",
    "tauri:dev": "tauri dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check:types": "tsc --noEmit",
    "version": "cargo set-version $npm_package_version --manifest-path src-tauri/Cargo.toml && git add src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-notification": "2.7.0",
    "@tauri-apps/plugin-positioner": "2.4.0",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10",
    "genversion": "3.2.0",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
